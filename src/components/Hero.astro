---
---
<section id="inicio" class="hero">
  <canvas id="matrix-canvas" aria-hidden="true"></canvas>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-logo-wrap">
      <img src="/skyhack-logo.png" alt="Sky-Hack CTF Logo" width="300" height="auto" class="hero-logo" />
    </div>

    <div class="hero-badge">
      <span class="badge-pulse" aria-hidden="true"></span>
      HTB La Paz &nbsp;·&nbsp; Bolivia &nbsp;·&nbsp; CTF 2026
    </div>

    <h1 class="hero-title">
      <span class="t-white">SKY</span><span class="t-dash">-</span><span class="t-green">HACK</span>
    </h1>
    <p class="hero-sub">LA PAZ <span class="t-green">2026</span></p>

    <div class="hero-meta" aria-label="Detalles del evento">
      <div class="meta-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        29 de Mayo, 2026
      </div>
      <span class="meta-dot" aria-hidden="true">·</span>
      <div class="meta-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        12 Horas
      </div>
      <span class="meta-dot" aria-hidden="true">·</span>
      <div class="meta-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        UCB La Paz, Bolivia
      </div>
    </div>

    <p class="countdown-heading" aria-label="El evento comienza en:">EL EVENTO COMIENZA EN</p>

    <div id="countdown" class="countdown" role="timer" aria-live="off" aria-label="Cuenta regresiva al evento">
      <div class="cd-unit">
        <div class="cd-box"><span class="cd-num" id="cd-days">00</span></div>
        <span class="cd-label">DÍAS</span>
      </div>
      <span class="cd-colon" aria-hidden="true">:</span>
      <div class="cd-unit">
        <div class="cd-box"><span class="cd-num" id="cd-hours">00</span></div>
        <span class="cd-label">HORAS</span>
      </div>
      <span class="cd-colon" aria-hidden="true">:</span>
      <div class="cd-unit">
        <div class="cd-box"><span class="cd-num" id="cd-minutes">00</span></div>
        <span class="cd-label">MIN</span>
      </div>
      <span class="cd-colon" aria-hidden="true">:</span>
      <div class="cd-unit">
        <div class="cd-box"><span class="cd-num" id="cd-seconds">00</span></div>
        <span class="cd-label">SEG</span>
      </div>
    </div>

    <a href="#inscripcion" class="cta-btn">
      <span>INSCRÍBETE AHORA</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>

    <p class="timing-note">
      Registro: <strong>7:30 AM</strong>
      <span aria-hidden="true"> · </span>
      Inicio: <strong>8:00 AM</strong>
      <span aria-hidden="true"> · </span>
      Puntualidad obligatoria
    </p>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <span>SCROLL</span>
    <div class="scroll-line"></div>
  </div>
</section>

<script>
  // ── Matrix rain ──────────────────────────────────────────────────────────
  const canvas = document.getElementById('matrix-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const CHARS = '01アイウエオカキクケコサシスセタチツテトナニハBCDEFGHIJKLMNOPQRSTUVWXYZ{}[]<>/\\';
  const FONT_SIZE = 13;
  let cols: number[] = [];

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    cols = Array(Math.floor(canvas.width / FONT_SIZE)).fill(1);
  }

  resize();
  window.addEventListener('resize', resize, { passive: true });

  function drawMatrix() {
    ctx.fillStyle = 'rgba(20, 29, 43, 0.04)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.font = `${FONT_SIZE}px "JetBrains Mono", monospace`;

    for (let i = 0; i < cols.length; i++) {
      ctx.fillStyle = i % 7 === 0 ? 'rgba(159,239,0,0.7)' : 'rgba(159,239,0,0.28)';
      ctx.fillText(CHARS[Math.floor(Math.random() * CHARS.length)], i * FONT_SIZE, cols[i] * FONT_SIZE);
      if (cols[i] * FONT_SIZE > canvas.height && Math.random() > 0.975) cols[i] = 0;
      cols[i]++;
    }
  }

  setInterval(drawMatrix, 45);

  // ── Countdown ────────────────────────────────────────────────────────────
  // 8:00 AM Bolivia Standard Time (UTC-4) = 12:00 UTC
  const TARGET = new Date('2026-05-29T12:00:00.000Z');

  const pad = (n: number) => String(n).padStart(2, '0');

  const elDays    = document.getElementById('cd-days')!;
  const elHours   = document.getElementById('cd-hours')!;
  const elMinutes = document.getElementById('cd-minutes')!;
  const elSeconds = document.getElementById('cd-seconds')!;
  const cdWrap    = document.getElementById('countdown')!;

  function tick() {
    const diff = TARGET.getTime() - Date.now();

    if (diff <= 0) {
      cdWrap.innerHTML = '<div class="cd-live">¡EL EVENTO ESTÁ EN VIVO!</div>';
      return;
    }

    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);

    elDays.textContent    = pad(d);
    elHours.textContent   = pad(h);
    elMinutes.textContent = pad(m);
    elSeconds.textContent = pad(s);
  }

  tick();
  setInterval(tick, 1000);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 7rem 1.5rem 5rem;
  }

  #matrix-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 80% 70% at 50% 50%, rgba(20,29,43,0.25) 0%, rgba(20,29,43,0.82) 55%, #141d2b 100%),
      linear-gradient(to bottom, rgba(20,29,43,0.75) 0%, transparent 25%, transparent 75%, rgba(20,29,43,0.95) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 860px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
  }

  .hero-logo-wrap {
    animation: float 3.5s ease-in-out infinite;
    filter: drop-shadow(0 0 30px rgba(159,239,0,0.45));
    max-width: 320px;
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .hero-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--green-dim);
    border: 1px solid rgba(159,239,0,0.3);
    color: var(--green);
    padding: 0.4rem 1.1rem;
    border-radius: 2px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .badge-pulse {
    width: 7px;
    height: 7px;
    background: var(--green);
    border-radius: 50%;
    flex-shrink: 0;
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(159,239,0,0.5); }
    50% { opacity: 0.5; box-shadow: 0 0 0 5px rgba(159,239,0,0); }
  }

  .hero-title {
    font-size: clamp(4.5rem, 14vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }

  .t-white { color: #fff; }
  .t-dash  { color: var(--green); }
  .t-green {
    color: var(--green);
    text-shadow: 0 0 30px rgba(159,239,0,0.7), 0 0 70px rgba(159,239,0,0.3);
  }

  .hero-sub {
    font-size: clamp(0.9rem, 2.5vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.35em;
    color: var(--grey);
    text-transform: uppercase;
    margin-top: -0.8rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    justify-content: center;
    color: var(--grey-dim);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .meta-item { display: flex; align-items: center; gap: 0.4rem; }
  .meta-dot { opacity: 0.3; }

  .countdown-heading {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: rgba(164,177,205,0.5);
    text-transform: uppercase;
    margin-bottom: -0.8rem;
  }

  .countdown {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.5rem, 2vw, 1.2rem);
  }

  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }

  .cd-box {
    background: rgba(159,239,0,0.05);
    border: 1px solid rgba(159,239,0,0.18);
    border-radius: 4px;
    padding: clamp(0.9rem, 2vw, 1.3rem) clamp(1rem, 3vw, 2rem);
    position: relative;
    overflow: hidden;
  }

  .cd-box::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: rgba(159,239,0,0.25);
  }

  .cd-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(2.8rem, 9vw, 5.5rem);
    font-weight: 700;
    color: var(--green);
    text-shadow:
      0 0 15px rgba(159,239,0,0.9),
      0 0 35px rgba(159,239,0,0.5),
      0 0 70px rgba(159,239,0,0.2);
    line-height: 1;
    display: block;
    min-width: 2ch;
    text-align: center;
    transition: transform 0.1s ease;
  }

  .cd-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(164,177,205,0.5);
  }

  .cd-colon {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 700;
    color: var(--green);
    opacity: 0.5;
    margin-top: clamp(0.8rem, 2vw, 1.2rem);
    animation: colon-blink 1s step-end infinite;
  }

  @keyframes colon-blink {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.1; }
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    background: var(--green);
    color: var(--black);
    text-decoration: none;
    padding: 1.1rem 3rem;
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
    box-shadow: 0 0 30px rgba(159,239,0,0.45), 0 4px 20px rgba(0,0,0,0.4);
    margin-top: 0.4rem;
  }

  .cta-btn:hover {
    background: #b8ff1a;
    box-shadow: 0 0 55px rgba(159,239,0,0.75), 0 6px 30px rgba(0,0,0,0.5);
    transform: translateY(-3px);
  }

  .cta-btn:active { transform: translateY(-1px); }

  .timing-note {
    font-size: 0.78rem;
    color: rgba(164,177,205,0.5);
    letter-spacing: 0.03em;
  }

  .timing-note strong { color: var(--grey); font-weight: 700; }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(164,177,205,0.3);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    animation: appear 1s 2s ease forwards;
    opacity: 0;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, rgba(159,239,0,0.5), transparent);
    animation: scroll-drip 1.8s ease-in-out infinite;
  }

  @keyframes appear {
    to { opacity: 1; }
  }

  @keyframes scroll-drip {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; opacity: 1; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  .cd-live {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.4rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--green);
    text-shadow: 0 0 30px rgba(159,239,0,0.8);
    animation: live-pulse 1s ease-in-out infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Mobile responsiveness for countdown */
  @media (max-width: 500px) {
    .countdown {
      gap: 0.2rem;
    }
    .cd-box {
      padding: 0.6rem 0.5rem;
    }
    .cd-num {
      font-size: clamp(1.8rem, 7vw, 2.8rem);
      min-width: 1.5ch;
    }
    .cd-colon {
      font-size: clamp(1.5rem, 5vw, 2rem);
      margin-top: 0.6rem;
      margin-left: 0.1rem;
      margin-right: 0.1rem;
    }
    .cd-label {
      font-size: 0.55rem;
      letter-spacing: 0.1em;
    }
  }
</style>
