---
---
<section id="sobre" class="about">
  <div class="container">

    <!-- Info cards row -->
    <div class="info-grid fade-in">
      <div class="info-card">
        <div class="info-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div class="info-card-body">
          <span class="info-card-label">Fecha y hora</span>
          <strong class="info-card-value">29 de Mayo, 2026</strong>
          <span class="info-card-sub">Registro: 7:30 AM &nbsp;·&nbsp; Inicio: 9:00 AM</span>
        </div>
      </div>

      <div class="info-card">
        <div class="info-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="info-card-body">
          <span class="info-card-label">Lugar</span>
          <strong class="info-card-value">UCB La Paz</strong>
          <span class="info-card-sub">Universidad Católica Boliviana, Bolivia</span>
        </div>
      </div>

      <div class="info-card">
        <div class="info-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div class="info-card-body">
          <span class="info-card-label">Formato</span>
          <strong class="info-card-value">CTF · 12 Horas</strong>
          <span class="info-card-sub">Individual o equipos de hasta 3</span>
        </div>
      </div>
    </div>

    <!-- Two-column layout -->
    <div class="about-grid">
      <!-- What is CTF -->
      <div class="about-block fade-in">
        <p class="section-label">¿Qué es Sky-Hack?</p>
        <h2 class="section-title">Hackea. Captura.<br /><span class="green-text">Conquista.</span></h2>
        <p class="about-text">
          <strong>Sky-Hack La Paz 2026</strong> es la primera competencia Capture The Flag organizada por la comunidad
          <strong>Hack The Box La Paz</strong> en Bolivia. Un desafío de ciberseguridad de 12 horas donde
          estudiantes universitarios ponen a prueba sus habilidades técnicas en un entorno real y controlado.
        </p>
        <p class="about-text">
          El objetivo es capturar <strong>"flags"</strong> — cadenas de texto ocultas en una arquitectura
          diseñada específicamente para el evento. Cada flag tiene puntaje asignado según su dificultad.
          En caso de empate, gana quien acumule el puntaje en menor tiempo.
        </p>
      </div>

      <!-- Requirements -->
      <div class="about-block fade-in" style="transition-delay: 0.15s">
        <p class="section-label">Requisitos</p>
        <h2 class="section-title">¿Quién puede<br /><span class="green-text">participar?</span></h2>

        <ul class="req-list">
          <li class="req-item">
            <div class="req-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <strong>Estudiante universitario vigente</strong>
              <p>Se solicitará credencial o comprobante de inscripción universitaria.</p>
            </div>
          </li>
          <li class="req-item">
            <div class="req-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <strong>Laptop propia con Wi-Fi</strong>
              <p>Computadora portátil con conexión Wi-Fi. Eres responsable de tu hardware (cargadores, adaptadores).</p>
            </div>
          </li>
          <li class="req-item">
            <div class="req-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <strong>Cuenta activa en Hack The Box</strong>
              <p>Regístrate en <a href="https://www.hackthebox.com" target="_blank" rel="noopener noreferrer" class="inline-link">hackthebox.com</a> antes del evento.</p>
            </div>
          </li>
        </ul>

        <!-- Registration CTA anchor -->
        <div id="inscripcion" class="reg-card">
          <div class="reg-card-inner">
            <div class="reg-status">
              <span class="reg-dot" aria-hidden="true"></span>
              <span>Inscripciones Abiertas</span>
            </div>
            <p class="reg-desc">Completa el formulario oficial para asegurar tu lugar. Cupos limitados.</p>
            <a
              href="https://docs.google.com/forms/d/e/1FAIpQLSf5DlPlu3ZQhJww1PMFhlhtNKtp9QcEFW_nRuxP09HXurGkvA/viewform?usp=sharing&ouid=112639955920823757253"
              target="_blank"
              rel="noopener noreferrer"
              class="reg-btn"
              aria-label="Formulario de inscripción"
            >
              FORMULARIO DE INSCRIPCIÓN
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 6rem 0;
    position: relative;
  }

  .about::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(159,239,0,0.3), transparent);
  }

  /* Info grid */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 5rem;
  }

  .info-card {
    background: var(--black-card);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .info-card:hover {
    border-color: rgba(159,239,0,0.2);
    transform: translateY(-2px);
  }

  .info-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    background: var(--green-dim);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--green);
  }

  .info-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .info-card-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey-dim);
  }

  .info-card-value {
    font-size: 1rem;
    font-weight: 800;
    color: var(--white);
    line-height: 1.2;
  }

  .info-card-sub {
    font-size: 0.78rem;
    color: var(--grey-dim);
    font-weight: 500;
  }

  /* Two-column about */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-block { display: flex; flex-direction: column; gap: 1.2rem; }

  .green-text {
    color: var(--green);
    text-shadow: 0 0 20px rgba(159,239,0,0.3);
  }

  .about-text {
    color: var(--grey);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .about-text strong { color: var(--white); }

  .flags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .flag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--green-dim);
    border: 1px solid rgba(159,239,0,0.25);
    color: var(--green);
    padding: 0.35rem 0.85rem;
    border-radius: 2px;
    font-size: 0.78rem;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.05em;
  }

  /* Requirements */
  .req-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .req-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .req-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    background: var(--green-dim);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--green);
    margin-top: 2px;
  }

  .req-item strong { font-size: 0.95rem; font-weight: 700; display: block; margin-bottom: 0.2rem; }
  .req-item p { font-size: 0.85rem; color: var(--grey); line-height: 1.5; }

  .inline-link {
    color: var(--green);
    text-decoration: none;
    border-bottom: 1px solid rgba(159,239,0,0.3);
    transition: border-color 0.2s;
  }
  .inline-link:hover { border-color: var(--green); }

  /* Registration card */
  .reg-card {
    background: linear-gradient(135deg, rgba(159,239,0,0.05) 0%, rgba(20,29,43,0) 100%);
    border: 1px solid rgba(159,239,0,0.25);
    border-radius: var(--radius);
    padding: 1.8rem;
    margin-top: 0.5rem;
  }

  .reg-card-inner { display: flex; flex-direction: column; gap: 1rem; }

  .reg-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
  }

  .reg-dot {
    width: 7px;
    height: 7px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 0 rgba(159,239,0,0.5); }
    50% { box-shadow: 0 0 0 5px rgba(159,239,0,0); }
  }

  .reg-desc { font-size: 0.88rem; color: var(--grey); line-height: 1.6; }

  .reg-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--green);
    color: var(--black);
    text-decoration: none;
    padding: 0.9rem 1.8rem;
    border-radius: var(--radius);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 0.2s, box-shadow 0.2s, transform 0.15s;
    box-shadow: 0 0 20px rgba(159,239,0,0.35);
    align-self: flex-start;
  }

  .reg-btn:hover {
    background: #b8ff1a;
    box-shadow: 0 0 35px rgba(159,239,0,0.6);
    transform: translateY(-2px);
  }

  .reg-note {
    font-size: 0.7rem;
    color: rgba(164,177,205,0.35);
    font-style: italic;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .info-grid { grid-template-columns: 1fr; }
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
